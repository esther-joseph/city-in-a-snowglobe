# Server-side only. Read by the /api/openweather proxy (Vercel function in
# production, Vite middleware in dev). Never exposed to the browser.
OPENWEATHER_API_KEY=your-openweathermap-key

# Origin that serves /api/openweather, baked into the client at build time.
# Leave unset for the web build (same origin). Required for the Android/iOS
# build, whose own origin is the local webview.
# VITE_WEATHER_API_BASE_URL=https://your-deployment.vercel.app

# --- Monetisation -----------------------------------------------------------
# AdSense publisher id for the web build. The loader script is injected into
# dist/index.html at build time, and never into the Android build.
VITE_ADSENSE_CLIENT=ca-pub-4752576373489354

# Ad unit ids. Slots with no id render nothing in production, so the app is
# safe to deploy before the units exist.
# VITE_ADSENSE_SLOT_DRAWER=1234567890
# VITE_ADSENSE_SLOT_FOOTER=0987654321

# AdMob units for the Play Store build, used instead of AdSense.
# VITE_ADMOB_UNIT_DRAWER=ca-app-pub-0000000000000000/0000000000
# VITE_ADMOB_UNIT_FOOTER=ca-app-pub-0000000000000000/1111111111
